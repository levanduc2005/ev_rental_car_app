# ==============================================================================
# E-MOTION MOBILE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env: cp .env.example .env
# Chạy dự án: flutter run --dart-define-from-file=.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 🟢 1. MÔI TRƯỜNG DEV (Local Android Emulator -> Backend Localhost)
# ------------------------------------------------------------------------------
FLAVOR=dev
API_BASE_URL=http://10.0.2.2:8080/api
ENABLE_LOGGING=true
API_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 🚀 2. MÔI TRƯỜNG PROD / TUNNEL (Ngrok -> Test máy thật hoặc từ xa)
# ------------------------------------------------------------------------------
# FLAVOR=prod
# API_BASE_URL=https://your-domain.ngrok-free.app/api
# ENABLE_LOGGING=false
# API_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 🔑 3. CREDENTIALS DÙNG CHUNG (Google OAuth, Cloudinary...)
# ------------------------------------------------------------------------------
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here
